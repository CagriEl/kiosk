APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_URL=https://kiosk.kirklareli.bel.tr/public

# Belsis SOAP Web Servisleri — canlı Kırklareli
BELSIS_USERNAME=kiosktahsilat
BELSIS_PASSWORD=
BELSIS_TAHAKKUK_URL=http://webservis.kirklareli.local:1685/belsisWebServis/tahakkukwebservis.asmx
BELSIS_TAHSILAT_URL=http://webservis.kirklareli.local:1685/belsisWebServis/tahsilatwebservis.asmx
# DNS kararsızsa (ping/getaddrinfo farkı): URL hostname kalsın, IP buraya
BELSIS_HOST_IP=
BELSIS_IP_ADDRESS=auto
BELSIS_VERIFY_SSL=false
BELSIS_TIMEOUT=45
BELSIS_MOCK=false
BELSIS_MOCK_ABONELER=89874
# Kırklareli kurulumunda arama methodu tüm sorguTip'ler için sunucu hatası veriyor — kapalı tutun.
BELSIS_ARAMA_ENABLED=false
BELSIS_ARAMA_SORGU_TIPS=TC,TcKimlikNo,2,TCKIMLIK,Tc,1,0
BELSIS_ODEME_SEKLI=5
BELSIS_WATER_MOCK=true
BAYLAN_IE_URL=http://belapp.belediye.local/Belsis-Net/genel/kioskwebservisV1/baylan.aspx?txtKartId=&txtYukle=&txtAboneNoC=&txtDonemC=&txtGensicilnoC=&txtIlkEndeksC=&txtYuklenecekC=&txtAtikSuMikC=

# Kiosk güvenlik / operasyon
KIOSK_ID=kiosk-1
KIOSK_API_KEY=
KIOSK_SUPPORT_PHONE=444 01 39
KIOSK_ENABLE_TEST_QUERY=false
KIOSK_RATE_LIMIT_ATTEMPTS=5
KIOSK_RATE_LIMIT_DECAY=600
KIOSK_QUERY_TOKEN_TTL=900
KIOSK_HEALTH_CHECK_BELSIS=true
KIOSK_AUDIT_LOG_DAYS=90
# Günlük rapor artık /kiosk-yonetim altında (şifreli)
KIOSK_REPORT_KEY=
# Yönetim paneli: http://10.0.1.1/kiosk/public/kiosk-yonetim
KIOSK_YONETIM_PASSWORD=Bi.34100!!

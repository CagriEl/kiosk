@echo off
chcp 65001 >nul
title Kirklareli Kiosk Baylan Kurulum

if /I "%~1"=="elevated" goto install
powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath '%~f0' -ArgumentList 'elevated' -Verb RunAs"
exit /b

:install
echo Kurulum basliyor...
echo.

powershell -NoProfile -ExecutionPolicy Bypass -Command "$p=Join-Path $env:TEMP 'kiosk-baylan-kurulum.ps1'; [IO.File]::WriteAllBytes($p,[Convert]::FromBase64String('')); try { & $p; $code=$LASTEXITCODE } catch { Write-Host $_.Exception.Message -ForegroundColor Red; $code=1 }; Remove-Item -LiteralPath $p -Force -ErrorAction SilentlyContinue; exit $code"

if errorlevel 1 (
  echo.
  echo HATA: Kurulum basarisiz.
  pause
  goto cleanup
)

echo.
echo Kurulum tamam. Bu pencere kapaninca dosya silinecek.
pause

:cleanup
(goto) 2>nul & del "%~f0"
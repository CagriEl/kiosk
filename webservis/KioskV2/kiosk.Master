<body class="body">

    <div class="header">
        <i class="fa fa-clock-o" aria-hidden="true"></i>&nbsp;
        <span id="tarihMaster" runat="server"></span>

        <span style="float: right; position: absolute; right: 30px;" id="belediyeAdiMaster" runat="server"></span>

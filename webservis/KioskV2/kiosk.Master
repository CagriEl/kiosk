</html>

<script type="text/javascript">


    if ("onhelp" in window)
        window.onhelp = function () {
            return false;
        }

    //ctrl tuşunu kullanamasın
    //alt için evt.altKey
    document.ondblclick = function () { return false; }
    document.onkeydown = function (e) {

        var evtobj = window.event ? event : e

        if (!evtobj) evtobj = window.event;
        if (!evtobj) return;

        var keyCode = evtobj.keyCode ? evtobj.keyCode : evtobj.charCode;

        if ((keyCode >= 112 && keyCode <= 123) || keyCode == 91 || keyCode == 93 || keyCode == 17 || keyCode == 18
            ) {
            // Standart DOM (Mozilla):
            if (evtobj.preventDefault)
                evtobj.preventDefault();
            //IE 
            if (document.all && window.evtobj && !evtobj.preventDefault) {

                evtobj.cancelBubble = true;

                evtobj.returnValue = false;

                evtobj.keyCode = 0;
            }
            //alert('F5 Tuşu Kullanamazsınız');
            return false;
        }

        
        if (evtobj.keyCode && evtobj.ctrlKey) {
            e.preventDefault();
            e.stopPropagation();
        }
    }
        
    /* Kullanıcı ekranda herhangibir işlem yapmazsa anasayfaya yönlendirmesi ile ilgili fonksiyonlar.
       Anasasayfada da  olmasının sebebi sunucuya erişimi kontrol etmesidir.
       Bekleme süresi totalMin değişkeni ile dakika cinsinden atanır. Varsayılan değer 10 olarak atanmıştır. */
    
    var totalMin = 10;
    var sayacDurumu = 1;
    var totalSeconds = totalMin * 9, totalMillis = 1000 * 9 * totalMin;

    function setDate() {
        window.setInterval(function () {
           
            if (sayacDurumu == 1) {
                console.log(totalSeconds);
                totalSeconds -= 1;
            }
            if (totalSeconds == 0) {
                sayacDurumu = 0;
                totalSeconds = totalMin * 9;
                totalMillis = 1000 * 9 * totalMin;
                $.ajax({
                    type: "POST",
                    url: "kontrol.aspx/belsisWebServis",
                    contentType: "application/json",
                    dataType: "json",
                    success: function (cevap) {

                        if (cevap.d == "1") {
                            yukleniyor.goster();
                            window.location.href = "default.aspx";
                        }
                        else {
                            baglaniyor.goster();
                            //setDate();
                        }
                        sayacDurumu = 1;
                    },
                    error: function (cevap) {
                        alert("İşlem Yapılamadı.");
                        sayacDurumu = 1;
                    }
                });               
            }
        }, 1000);
    }

    $(document).ready(function () {
        setDate();
        $(window).click(function () {
            totalSeconds = totalMin * 9;
            totalMillis = 1000 * 9 * totalMin;
        });
    });
   
</script>
